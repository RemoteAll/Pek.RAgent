<?xml version="1.0" encoding="utf-8"?>
<StarAgent>
  <!--调试开关。默认true-->
  <Debug>false</Debug>
  <!--证书-->
  <Code></Code>
  <!--密钥-->
  <Secret></Secret>
  <!--项目名。新节点默认所需要加入的项目-->
  <Project></Project>
  <!--星尘服务端地址。预留（`-server` 参数写入，C# StarAgent 会忽略）-->
  <Server></Server>
  <!--本地端口。默认5500-->
  <LocalPort>5500</LocalPort>
  <!--更新通道。默认Release-->
  <Channel>Release</Channel>
  <!--Windows自启动。自启动需要用户登录桌面，默认false使用系统服务-->
  <UseAutorun>false</UseAutorun>
  <!--延迟时间。重启进程或服务的延迟时间，默认3000ms-->
  <Delay>3000</Delay>
  <!--同步时间间隔。定期同步服务器时间到本地，默认0秒不同步-->
  <SyncTime>0</SyncTime>
  <!--启动挂钩。拉起目标进程时，对dotNet应用注入星尘监控钩子，默认false-->
  <StartupHook>false</StartupHook>

  <!--———————————————— 以下为 Pek.RAgent 扩展配置（C# StarAgent 会忽略未知项） ————————————————-->
  <!--服务名。默认 StarAgent，与现有部署脚本/服务名保持一致-->
  <ServiceName>StarAgent</ServiceName>
  <!--显示名-->
  <DisplayName>星尘代理</DisplayName>
  <!--服务描述-->
  <Description>星尘节点守护代理（Pek.RAgent）。提供进程守护、影子目录部署与本地控制接口。</Description>
  <!--仅本机访问。默认 true（只绑定 127.0.0.1）-->
  <LocalOnly>true</LocalOnly>
  <!--启动等待时间（毫秒）。该时间内进程退出视为启动失败，默认 3000-->
  <StartWait>3000</StartWait>
  <!--最大失败次数。超过后不再尝试启动，默认 20-->
  <MaxFails>20</MaxFails>
  <!--守护检查周期（毫秒），默认 30000-->
  <GuardPeriod>30000</GuardPeriod>
  <!--看门狗。保护其它服务，每分钟检查一次；多个进程名逗号分隔-->
  <WatchDog></WatchDog>
  <!--Web 面板用户名。默认 admin-->
  <WebUserName>admin</WebUserName>
  <!--Web 面板密码。默认 admin-->
  <WebPassword>admin</WebPassword>
  <!--Web 面板鉴权级别（None/LocalOnly/Full）。默认 LocalOnly-->
  <WebAuthLevel>LocalOnly</WebAuthLevel>

  <!--应用服务集合-->
  <Services></Services>
</StarAgent>
