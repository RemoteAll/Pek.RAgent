<?xml version="1.0" encoding="utf-8"?>
<StarAgent>
  <!--调试开关。默认true-->
  <Debug>false</Debug>
  <!--证书-->
  <Code></Code>
  <!--密钥-->
  <Secret></Secret>
  <!--项目名。新节点默认所需要加入的项目-->
  <Project></Project>
  <!--星尘服务端地址。预留（`-server` 参数写入，C# StarAgent 会忽略）-->
  <Server></Server>
  <!--本地端口。默认5500-->
  <LocalPort>5500</LocalPort>
  <!--更新通道。默认Release-->
  <Channel>Release</Channel>
  <!--Windows自启动。自启动需要用户登录桌面，默认false使用系统服务-->
  <UseAutorun>false</UseAutorun>
  <!--延迟时间。重启进程或服务的延迟时间，默认3000ms-->
  <Delay>3000</Delay>
  <!--同步时间间隔。定期同步服务器时间到本地，默认0秒不同步-->
  <SyncTime>0</SyncTime>
  <!--启动挂钩。拉起目标进程时，对dotNet应用注入星尘监控钩子，默认false-->
  <StartupHook>false</StartupHook>

  <!--———————————————— 以下为 Pek.RAgent 扩展配置（C# StarAgent 会忽略未知项） ————————————————-->
  <!--服务名。默认 StarAgent，与现有部署脚本/服务名保持一致-->
  <ServiceName>StarAgent</ServiceName>
  <!--显示名-->
  <DisplayName>星尘代理</DisplayName>
  <!--服务描述-->
  <Description>星尘节点守护代理（Pek.RAgent）。提供进程守护、影子目录部署与本地控制接口。</Description>
  <!--仅本机访问。true 时只绑定 127.0.0.1；默认 false（允许远程访问——无头服务器需远程管理面板，请确保面板密码安全）-->
  <LocalOnly>false</LocalOnly>
  <!--启动等待时间（毫秒）。该时间内进程退出视为启动失败，默认 3000-->
  <StartWait>3000</StartWait>
  <!--最大失败次数。超过后不再尝试启动，默认 20-->
  <MaxFails>20</MaxFails>
  <!--守护检查周期（毫秒），默认 30000-->
  <GuardPeriod>30000</GuardPeriod>
  <!--看门狗。保护其它服务，每分钟检查一次；多个进程名逗号分隔-->
  <WatchDog></WatchDog>
  <!--Web 面板用户名。默认 admin-->
  <WebUserName>admin</WebUserName>
  <!--Web 面板密码。默认 admin-->
  <WebPassword>admin</WebPassword>
  <!--Web 面板鉴权级别。None不鉴权；LocalOnly本地免鉴权、远程需登录（默认）；Full全部需登录-->
  <WebAuthLevel>LocalOnly</WebAuthLevel>
  <!--后台资源采样间隔（毫秒）。默认 1000（与任务管理器/宝塔同粒度）；0 = 关闭后台采样（改为面板请求时现采）-->
  <SampleInterval>1000</SampleInterval>
  <!--网站流量统计。解析 nginx/apache 访问日志（自动发现常见站点 + 下方手动补充），默认 true-->
  <WebTraffic>true</WebTraffic>
  <!--网站日志手动配置。`名称=路径;名称2=路径2`；自动发现不到时补充（如 Caddy 自定义日志、非标准目录）-->
  <WebLogs></WebLogs>
  <!--端口流量统计。Linux 使用 nftables 独立计数表统计各端口收发流量（需 root）；默认 false（启用后会在系统中创建 pek_stats 计数表）-->
  <PortTraffic>false</PortTraffic>
  <!--端口流量统计端口。形如 `22,80,443,3306`；留空 = 自动取系统监听端口-->
  <PortTrafficPorts></PortTrafficPorts>

  <!--应用服务集合-->
  <Services></Services>
</StarAgent>
